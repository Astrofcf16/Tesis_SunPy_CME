import os
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
import sunpy.map
from sunpy.time import parse_time
from datetime import datetime

# Configuración
ruta_c2 = "/home/steve/lasco_evento1/c2/"
ruta_c3 = "/home/steve/lasco_evento1/c3/"
theta_min, theta_max = 175, 181  # Ángulo corregido
num_r = 1024
num_theta = 179
pixeles_por_rsun = 122.0  # 1 R_sun ≈ 122 px en LASCO C2/C3

# Función para extraer la altura máxima en un sector
def extraer_sector_max_altura(archivo):
    mapa = sunpy.map.Map(archivo)
    data = mapa.data
    sector_data = np.full((num_r, num_theta), np.nan)

    r = np.linspace(0, data.shape[0] // 2, num_r)
    theta = np.linspace(np.radians(theta_min), np.radians(theta_max), num_theta)
    X = (r[:, None] * np.cos(theta)).astype(int) + data.shape[1] // 2
    Y = (r[:, None] * np.sin(theta)).astype(int) + data.shape[0] // 2

    mask = (X >= 0) & (X < data.shape[1]) & (Y >= 0) & (Y < data.shape[0])
    sector_data[mask] = data[Y[mask], X[mask]]

    max_pos = np.nanargmax(sector_data)
    max_row = max_pos // sector_data.shape[1]  # Fila con altura máxima
    tiempo = mapa.date.datetime.strftime("%Y-%m-%d %H:%M:%S")
    altura_rsun = max_row / pixeles_por_rsun
    return tiempo, max_row, altura_rsun

# Procesar imágenes C2
datos_c2 = []
print("📊 Procesando LASCO C2...")
for file in sorted(os.listdir(ruta_c2)):
    if file.endswith(".fts"):
        ruta = os.path.join(ruta_c2, file)
        try:
            t, px, rs = extraer_sector_max_altura(ruta)
            datos_c2.append((t, px, rs, "LASCO C2"))
            print(f"✔️ {t} | px: {px} | R⊙: {rs:.2f}")
        except Exception as e:
            print(f"⚠️ Error con {file}: {e}")

# Procesar imágenes C3
datos_c3 = []
print("\n📊 Procesando LASCO C3...")
for file in sorted(os.listdir(ruta_c3)):
    if file.endswith(".fts"):
        ruta = os.path.join(ruta_c3, file)
        try:
            t, px, rs = extraer_sector_max_altura(ruta)
            datos_c3.append((t, px, rs, "LASCO C3"))
            print(f"✔️ {t} | px: {px} | R⊙: {rs:.2f}")
        except Exception as e:
            print(f"⚠️ Error con {file}: {e}")

# Unir y ordenar tabla
tabla = datos_c2 + datos_c3
tabla.sort(key=lambda x: x[0])  # Ordenar por tiempo

# Mostrar tabla
print("\n📋 Tabla H vs t (Evento 1):")
print(f"{'Tiempo':<20} {'Altura (px)':<12} {'Altura (R⊙)':<14} {'Detector'}")
for fila in tabla:
    print(f"{fila[0]:<20} {fila[1]:<12} {fila[2]:<14.2f} {fila[3]}")

# Gráfica H vs t
tiempos = [datetime.strptime(row[0], "%Y-%m-%d %H:%M:%S") for row in tabla]
alturas = [row[2] for row in tabla]
labels = [row[3] for row in tabla]

colores = {'LASCO C2': 'blue', 'LASCO C3': 'green'}
fig, ax = plt.subplots(figsize=(10, 6))
for detector in ['LASCO C2', 'LASCO C3']:
    tiempos_d = [t for t, l in zip(tiempos, labels) if l == detector]
    alturas_d = [h for h, l in zip(alturas, labels) if l == detector]
    ax.plot(tiempos_d, alturas_d, 'o-', label=detector, color=colores[detector])

ax.xaxis.set_major_formatter(mdates.DateFormatter('%H:%M'))
plt.xticks(rotation=30)

ax.set_xlabel("Hora (UT)")
ax.set_ylabel("Altura (R⊙)")
ax.set_title("Diagrama H vs t - Evento 1 (LASCO C2 y C3)")
ax.grid(True)
ax.legend()
plt.tight_layout()
plt.show()
